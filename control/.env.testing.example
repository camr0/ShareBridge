# .env.testing.example — template for control/.env.testing (gitignored).
#
# Setup:  cp .env.testing.example .env.testing   then fill in real values.
# Never commit .env.testing. deploy-testing-relay.sh sources this file and
# forwards the values to the test VPS over ssh stdin; values are never
# echoed to stdout.
#
# Every key below is read by control/deploy-testing-relay.sh; the remote env
# names control actually consumes are pinned to control/internal/config/
# config.go (Load()), the gateway to relay/cmd/gateway/main.go.

# ---- required ---------------------------------------------------------------

# Cloudflare API token with DNS-edit permission on the test base domain zone
# (used for direct-mode DDNS/ACME DNS-01 and the enrollment-time
# *.relay.<namespace>.<base-domain> wildcard A record).
CLOUDFLARE_TOKEN=cf_dns_edit_token_here

# Public hostname agents' frpc connects to for the FRP transport.
# Becomes relay_config.gateway_addr; must match the frps transport
# certificate SAN the deploy script issues. RFC 1123 hostname.
RELAY_GATEWAY_HOST=relay-test.example.com

# Public IPv4 of the test VPS. Control points the per-namespace
# *.relay.<namespace>.<base-domain> wildcard A record here at enrollment.
RELAY_GATEWAY_IPV4=203.0.113.10

# 64-hex-char Ed25519 relay auth seed (openssl rand -hex 32). Control signs
# tunnel credentials with it; the deploy script derives the public key for
# the gateway. KEEP STABLE across re-runs or every agent credential breaks.
RELAY_AUTH_KEY_SEED=64_hex_chars_generated_by_openssl_rand_hex_32_

# Hex secret shared by frps and the gateway's loopback authorization plugin
# (openssl rand -hex 16). Hex only: it is embedded in the frps httpPlugins
# URL userinfo, so URL-unsafe characters would corrupt the endpoint.
SHAREBRIDGE_FRP_PLUGIN_SHARED_SECRET=32_hex_chars_generated_by_openssl

# ---- optional (defaults shown; used by the phase-3 control path too) --------

# Test base domain (Cloudflare zone CLOUDFLARE_TOKEN can edit).
CONTENT_BASE_DOMAIN=example.com
# ACME account email for content certificate issuance.
ACME_EMAIL=you@example.com
# ACME directory. Keep production: agents validate against the system trust
# store, so Let's Encrypt staging roots are rejected.
ACME_CA_DIR=https://acme-v02.api.letsencrypt.org/directory
# Control's plain-HTTP port on the test box.
PORT=8080

# ---- optional relay knobs (defaults shown) -----------------------------------

# Public FRP transport port (frps bindPort = agents' gateway_port). Must not
# collide with 443 (gateway), PORT (control), 3478 (STUN) or the proxy range.
RELAY_GATEWAY_PORT=7000
# Inclusive frps proxy port range (spec §15.1 narrow allowPorts; matches
# control's RELAY_PORT_MIN/MAX and the gateway's SHAREBRIDGE_RELAY_PORT_*).
RELAY_PORT_MIN=10000
RELAY_PORT_MAX=10099
# Publicly resolvable host:port advertised in stun_challenge. Defaults to
# <ssh-host>:3478; override with the VPS IPv4 or DNS name if the ssh alias
# is not publicly resolvable. Port must be 3478 (stun.ParseBindAddr).
STUN_ADVERTISE_ADDR=203.0.113.10:3478
# Task 20 route-selection flag (getEnvBool, fail-closed). Deploy default is
# true for the phase-4a gates; false = rollback mode (relay never selected).
RELAY_SELECTION_ENABLED=true
