# Embedded libp2p relay configuration
# Relay listens on loopback only; Caddy or another reverse proxy should expose it publicly.
RELAY_LISTEN_ADDR=/ip4/127.0.0.1/tcp/9001/ws

# Public address clients should dial for the relay.
# Example: /dns4/relay.sharebridge.app/tcp/443/wss
RELAY_ANNOUNCE_ADDR=/dns4/your-relay-domain.example/tcp/443/wss

# Persist the relay identity across restarts so the peer ID stays stable.
RELAY_PRIVATE_KEY_PATH=/data/relay.key

# Secure JWT secret for relay auth. Generate one with:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-hex-character-secret
JWT_TTL=5m

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Quota settings
DEFAULT_QUOTA_GB=50
QUOTA_CHECK_INTERVAL=5m
